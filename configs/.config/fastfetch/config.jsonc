{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#ffffff"
    },
    "key": {
      "width": 14
    }
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/jirachi.txt",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#FF8282",
        "at": "#666666",
        "host": "#FFACF3"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[90m ───────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": " 󰣇 OS",
      "keyColor": "#56B6FF",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": " 󰌽 Kernel",
      "keyColor": "#BE8CFF"
    },
    {
      "type": "packages",
      "key": " 󰏖 Packages",
      "keyColor": "#FF9E64"
    },
    {
      "type": "shell",
      "key": "  Shell",
      "keyColor": "#66E880",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "  WM",
      "keyColor": "#E5D142",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "  CPU",
      "keyColor": "#45E3CD"
    },
    {
      "type": "gpu",
      "key": " 󰢮 GPU",
      "keyColor": "#E485F6"
    },
    {
      "type": "display",
      "key": " 󰍹 Screen",
      "keyColor": "#7A9CFF",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },    
    {
      "type": "memory",
      "key": "  Ram",
      "keyColor": "#FF75A0",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": " 󰋊 Disk",
      "keyColor": "#94F0AD",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "uptime",
      "key": " 󰔚 Uptime",
      "keyColor": "#F7C77E"
    },
    "break",
    {
      "type": "custom",
      "key": " 󰸱 Color",
      "format": "\u001b[38;2;255;225;86m󰮯 \u001b[38;2;69;201;229m \u001b[38;2;255;99;132m󰊠 \u001b[38;2;74;222;128m󰊠 \u001b[38;2;56;189;248m󰊠 \u001b[38;2;192;132;252m󰊠 \u001b[38;2;255;255;255m󰊠 \u001b[0m"
    }
  ]
}
